#ifndef UTLootRevealIncluded
#define UTLootRevealIncluded
#include "Crainax/ui/composite/loot/LootConstants.j"
#undef OriginMapUnitTestMode
#define EmptyMapUnitTestMode
// Shell generated by TaskCreateUT.lua; dependencies use cfg injection.
//! zinc
library UTLootReveal requires LootPopup, LootBanner, Tooltip, ToolTipStack {
    private lootReveal sample = 0;
    private tooltip tip = 0;
    private integer reveals = 0;
    private integer closes = 0;
    private integer callbackMode = 0;
    private string events = "";
    private boolean regressionRunning = false;
    private integer regressionCase = 0;
    private integer regressionPhase = 0;
    private integer regressionWait = 0;
    private integer regressionFailures = 0;
    private integer regressionChecks = 0;
    private boolean regressionBusy = false;
    private boolean regressionStopping = false;
    private lootReveal testA = 0;
    private lootReveal testB = 0;
    private lootReveal testC = 0;
    private integer baseFrames = 0;
    private integer baseEsc = 0;
    private integer baseResizes = 0;
    private integer basePointers = 0;

    private function Log(string value) { Trace("[LootReveal] " + value); }
    private function ClearTip() {
        if (tip != 0) { tip.destroy(); tip = 0; tooltipStack.clear(); }
    }
    private function Enter(integer view, integer index, integer data, integer frame) {
        lootReveal shown = view;
        events += "E" + I2S(index);
        if (callbackMode == 1) { return; }
        ClearTip();
        tip = tooltip.create().layoutTitleDesc(shown.getName(index),
            "|cFFCE96F0战利品属性示意|r|n攻击增幅 +12%|n生命增幅 +8%|n护甲 +15|n暴击 +6%|n攻速 +10%|n移动速度 +20|n技能增幅 +9%|n|nuserData=" + I2S(data) + "，序号=" + I2S(index))
            .setAbsPoint(ANCHOR_BOTTOMRIGHT, 0.786, 0.1675);
        tooltipStack.pushOrigin();
    }
    private function Leave(integer view, integer index, integer data, integer frame) {
        lootReveal shown = view;
        events += "L" + I2S(index); ClearTip();
        if (callbackMode == 2 && shown.isExist()) { shown.close(); }
        if (callbackMode == 3 && shown.isExist()) { shown.destroy(); }
    }
    private function Reveal(integer view, integer index, integer data, integer frame) {
        lootReveal shown = view;
        reveals += 1;
        if (callbackMode == 4 && shown.isExist()) { shown.close(); }
    }
    private function Closed(integer view) {
        closes += 1; ClearTip();
        Log("关闭通知，实例=" + I2S(view));
    }
    private function Make(integer mode, integer amount) -> lootReveal {
        lootReveal result = 0;
        integer i = 0;
        string name = "圣晶石";
        if (mode == LOOT_MODE_POPUP) { result = lootPopup.create(DzGetGameUI()).setTitle("打造成功").setCloseText("继续打造"); }
        else { result = lootBanner.create(DzGetGameUI()); }
        result.setSubtitle("已放入仓库 · 测试展示").onEnter(lootItemEvent.Enter).onLeave(lootItemEvent.Leave);
        result.onReveal(lootItemEvent.Reveal).onClose(lootCloseEvent.Closed);
        for (1 <= i <= amount) {
            name = "圣晶石 " + I2S(i);
            if (i == amount && amount > 1) { name = "这是用于检查截断的长名称圣晶石"; }
            result.addItem("ReplaceableTextures\\CommandButtons\\BTNOrbOfFrost.blp", name, i, ModuloInteger(i - 1, 4), 1000 + i);
        }
        return result;
    }
    private function Reset() {
        callbackMode = 0;
        if (sample.isExist()) { sample.destroy(); }
        sample = 0; ClearTip();
        reveals = 0; closes = 0; events = "";
    }
    private function Check(boolean condition, string label) {
        regressionChecks += 1;
        if (!condition) { regressionFailures += 1; }
        assert.Boolean(condition, "[LootReveal case=" + I2S(regressionCase) + "] " + label);
    }
    private function Equal(integer actual, integer expected, string label) {
        regressionChecks += 1;
        if (actual != expected) { regressionFailures += 1; }
        assert.Integer(actual, expected, "[LootReveal case=" + I2S(regressionCase) + "] " + label);
    }
    // One phase per real timer evaluation. No manual tick/fast-forward loop:
    // construction, playback, checks, close and destroy get separate VM budgets.
    private function RegressionStep() {
        integer amount = ModuloInteger(regressionCase, 10) + 1;
        integer mode = regressionCase / 10;
        if (regressionPhase == 90) {
            callbackMode = 1;
            if (testA.isExist()) { testA.destroy(); } testA = 0;
            regressionPhase = 91; return;
        }
        if (regressionPhase == 91) {
            if (testB.isExist()) { testB.destroy(); } testB = 0;
            regressionPhase = 92; return;
        }
        if (regressionPhase == 92) {
            if (testC.isExist()) { testC.destroy(); } testC = 0;
            regressionPhase = 93; return;
        }
        if (regressionPhase == 93) {
            Equal(uiId.getActiveCount(), baseFrames, "final frame balance");
            Equal(escStack.getSize(), baseEsc, "final Esc balance");
            Equal(resizer.size, baseResizes, "final resize balance");
            Equal(rePointer.size, basePointers, "final anchor balance");
            Equal(lootReveal.getQueueCount(), 0, "final queue empty");
            Equal(lootReveal.getActive(), 0, "final active empty");
            // Count notifications after cleanup too: destroy after close must
            // stay silent, while directly destroying a shown view notifies once.
            // A user-aborted case may not have reached show/close yet.
            if (!regressionStopping) {
                if (regressionCase == 21) { Equal(closes, 3, "each queued or shown view closes once"); }
                else if (regressionCase == 20 || regressionCase == 28) { Equal(closes, 0, "unshown views do not notify close"); }
                else { Equal(closes, 1, "exactly one close notification including destruction"); }
            }
            if (regressionFailures != 0 || regressionStopping || regressionCase >= 28) {
                regressionRunning = false; callbackMode = 0;
                Log("回归结束：检查=" + I2S(regressionChecks) + "，失败=" + I2S(regressionFailures)
                    + "，停止位置=" + I2S(regressionCase) + "；s1~s6 可手动展示。");
                return;
            }
            regressionCase += 1; regressionPhase = 0; regressionWait = 0; return;
        }
        if (regressionPhase == 0) {
            // Wait for the normal close-to-next-result input guard interval.
            regressionWait += 1; if (regressionWait < 6) { return; }
            baseFrames = uiId.getActiveCount(); baseEsc = escStack.getSize();
            baseResizes = resizer.size; basePointers = rePointer.size;
            callbackMode = 1; reveals = 0; closes = 0; events = "";
            regressionWait = 0;
            Log("开始 case=" + I2S(regressionCase) + "（0..9弹窗1..10件；10..19半屏；20..28边界/回调）");
            if (regressionCase == 20) {
                Check(lootReveal.testShortName("圣晶石") == "圣晶石", "short Chinese name preserved");
                Check(lootReveal.testShortName("这是用于检查截断的长名称圣晶石") == "这是用于检查截…", "Chinese name cuts at codepoint boundary");
                Check(lootReveal.testShortName("ABC圣晶石12") == "ABC圣晶石1…", "mixed name cuts at codepoint boundary");
                testA = lootPopup.create(DzGetGameUI());
                Check(!testA.show(), "empty refused");
                Equal(testA.addItem("", "空图标", 1, 0, 0), 0, "empty icon refused");
                Equal(testA.addItem("x", "数量无效", 0, 0, 0), 0, "invalid amount refused");
                Equal(testA.addItem("x", "品质无效", 1, 4, 0), 0, "invalid style refused");
                testB = Make(0, 10);
                Equal(testB.addItem("x", "overflow", 1, 0, 0), 0, "rejects item eleven");
                Check(testB.clear(), "closed clear allowed");
                Equal(testB.getCount(), 0, "clear resets count");
                regressionPhase = 90; return;
            }
            if (regressionCase == 28) {
                testA = Make(0, 1); testB = Make(0, 1);
                Check(testA != testB, "allocation pool not double recycled");
                regressionPhase = 90; return;
            }
            if (regressionCase >= 20) { mode = 0; amount = 2; }
            if (regressionCase == 25) { mode = 1; callbackMode = 4; }
            if (regressionCase == 26 || regressionCase == 27) { amount = 10; }
            testA = Make(mode, amount);
            Check(testA.show(), "show accepted");
            if (regressionCase == 21) {
                testB = Make(1, 1); testC = Make(0, 1);
                Check(testB.show() && testC.show(), "queue accepted");
            }
            regressionPhase = 1; return;
        }
        if (regressionPhase == 1) {
            regressionWait += 1;
            if (regressionCase == 26 || regressionCase == 27) {
                if (regressionWait < 3) { return; }
                Check(testA.isShown() && !testA.isReady(), "partial construction active");
                if (regressionCase == 26) {
                    escStack.pop();
                    Check(!testA.isShown(), "Esc cancels partial construction");
                    Check(testA.testFramesReleased(), "partial construction refs cleared");
                } else { testA.destroy(); testA = 0; }
                regressionPhase = 90; return;
            }
            if (regressionCase == 25) {
                if (reveals == 0 && regressionWait < 200) { return; }
                Check(reveals > 0 && !testA.isShown() && !testA.isQueued(), "reveal callback can close");
                regressionPhase = 90; return;
            }
            if (!testA.isReady() && regressionWait < 200) { return; }
            Check(testA.isReady(), "reveal completes");
            if (!testA.isReady()) {
                Log("等待展示超时，active=" + I2S(lootReveal.getActive()) + "，queue=" + I2S(lootReveal.getQueueCount()));
                regressionPhase = 90; return;
            }
            regressionPhase = 2; return;
        }
        if (regressionPhase == 2) {
            if (regressionCase < 20) {
                Equal(testA.getCount(), amount, "correct item count");
                Equal(testA.getUserData(1), 1001, "opaque user data");
                Check(testA.getItemFrame(amount) != 0, "final item frame exists");
                Check(testA.show(), "repeated show harmless");
                Equal(escStack.getSize(), baseEsc + 1, "one Esc entry");
                Equal(reveals, amount, "one reveal callback per item");
                Equal(closes, 0, "show does not notify close");
                Equal(testA.addItem("x", "冻结", 1, 0, 0), 0, "shown data frozen");
                Check(!testA.clear(), "shown clear refused");
                regressionPhase = 3; return;
            }
            if (regressionCase == 21) {
                Check(testB.isQueued() && testC.isQueued(), "queue preserves active result");
                Equal(lootReveal.getQueueCount(), 2, "queue size two");
                testB.close();
                Equal(lootReveal.getQueueCount(), 1, "cancel queued head");
                Equal(closes, 1, "queued cancellation notifies once");
                testB.close();
                Equal(closes, 1, "repeated queued close stays silent");
                regressionPhase = 3; return;
            }
            // Normalize automatic mouse hover before deterministic enter/leave.
            lootReveal.frameLeave(testA.getItemFrame(1)); lootReveal.frameLeave(testA.getItemFrame(2)); events = "";
            lootReveal.frameEnter(testA.getItemFrame(1));
            if (regressionCase == 23) { callbackMode = 2; }
            if (regressionCase == 24) { callbackMode = 3; }
            lootReveal.frameEnter(testA.getItemFrame(2));
            if (regressionCase == 22) {
                lootReveal.frameLeave(testA.getItemFrame(1));
                Check(events == "E1L1E2", "late leave cannot clear new hover");
                regressionPhase = 3;
            } else {
                Check(!testA.isShown(), "leave may close/destroy safely");
                if (regressionCase == 24) { testA = 0; }
                regressionPhase = 90;
            }
            return;
        }
        if (regressionPhase == 3) {
            if (regressionCase == 21) {
                escStack.pop(); regressionWait = 0; regressionPhase = 4; return;
            }
            testA.close();
            Equal(closes, 1, "close notifies once");
            Check(testA.testFramesReleased(), "close zeros every owned UI reference");
            if (!testA.testFramesReleased()) {
                regressionRunning = false;
                Log("清理引用未归零，停止回归；请重新启动地图，避免重复销毁。"); return;
            }
            if (regressionCase == 22) { Check(events == "E1L1E2L2", "close balances hover"); }
            regressionPhase = 4; return;
        }
        if (regressionPhase == 4) {
            if (regressionCase == 21) {
                regressionWait += 1;
                if (!testC.isReady() && regressionWait < 200) { return; }
                Check(testC.isReady(), "next result after Esc");
                Check(!testA.isShown(), "Esc closes only previous result");
            } else {
                testA.close();
                Equal(closes, 1, "repeated close stays silent");
            }
            regressionPhase = 90;
        }
    }
    private function RegressionTick() {
        if (!regressionRunning) { return; }
        if (regressionBusy) {
            // A previous evaluation did not return. Never silently start another
            // case and orphan its active view; keep its owning references.
            Log("回归执行中断：case=" + I2S(regressionCase) + " phase=" + I2S(regressionPhase));
            regressionFailures += 1; regressionStopping = true;
            if (regressionPhase >= 90) {
                regressionRunning = false;
                Log("清理阶段中断，请重新启动地图，避免重复回收。"); return;
            }
            regressionPhase = 90;
        }
        regressionBusy = true;
        RegressionStep();
        regressionBusy = false;
    }
    private function Show(integer mode, integer amount) {
        boolean accepted = false;
        Reset(); sample = Make(mode, amount); accepted = sample.show();
        Log("展示请求 mode=" + I2S(mode) + " count=" + I2S(amount) + " view=" + I2S(sample)
            + " active=" + I2S(lootReveal.getActive()) + " queue=" + I2S(lootReveal.getQueueCount()));
        if (!accepted) { Log("展示请求被拒绝。"); }
        else if (sample.isQueued()) { Log("已进入队列，等待当前展示关闭。"); }
    }
    private function QueueClosed(integer view) {
        lootReveal shown = view;
        ClearTip();
        if (shown.isExist()) { shown.destroy(); }
    }
    private function onInit() {
        uianim.create(function RegressionTick).reg();
        UnitTestAutoTimer(0.5, 0.0, function() {
            Log("手动展示已就绪；输入 s8 执行完整分帧回归（开局不自动运行）。");
            Log("s1=弹窗1件 s2=弹窗5件 s3=弹窗10件 s4=半屏1件 s5=半屏5件 s6=半屏10件");
            Log("s7=串行三批 s8=状态回归 s9=关闭销毁 s10=重播；-p N / -b N 测试1..10件");
        }, null);
        UnitTestRegisterChatEvent(function() {
            string command = GetEventPlayerChatString();
            integer amount = 0;
            lootReveal nextView = 0;
            if (GetTriggerPlayer() != GetLocalPlayer()) { return; }
            if (regressionRunning) {
                if (command == "s9") { regressionStopping = true; regressionPhase = 90; }
                else { Log("状态回归进行中，请稍候；s9 可中止并清理。"); }
                return;
            }
            if (command == "s1") { Show(0, 1); }
            else if (command == "s2") { Show(0, 5); }
            else if (command == "s3") { Show(0, 10); }
            else if (command == "s4") { Show(1, 1); }
            else if (command == "s5") { Show(1, 5); }
            else if (command == "s6") { Show(1, 10); }
            else if (command == "s7") {
                if (lootReveal.getActive() == 0 && lootReveal.getQueueCount() == 0) {
                    Reset();
                    nextView = Make(0, 1).onClose(lootCloseEvent.QueueClosed); nextView.show();
                    nextView = Make(1, 5).onClose(lootCloseEvent.QueueClosed); nextView.show();
                    nextView = Make(0, 10).onClose(lootCloseEvent.QueueClosed); nextView.show();
                } else { Log("请先关闭当前奖励与队列，再输入 s7。"); }
            }
            else if (command == "s8") {
                if (lootReveal.getQueueCount() == 0 && (lootReveal.getActive() == 0 || lootReveal.getActive() == sample)) {
                    Reset(); regressionCase = 0; regressionPhase = 0; regressionWait = 0;
                    baseFrames = uiId.getActiveCount(); baseEsc = escStack.getSize();
                    baseResizes = resizer.size; basePointers = rePointer.size;
                    regressionFailures = 0; regressionChecks = 0; regressionBusy = false; regressionStopping = false;
                    regressionRunning = true;
                    Log("开始分帧回归，约 30 秒；完成后输出检查/失败总数，s9 可中止并清理。");
                }
                else { Log("请先关闭当前奖励与队列，再输入 s8。"); }
            }
            else if (command == "s9") { Reset(); }
            else if (command == "s10") { if (sample.isExist()) { sample.close(); sample.show(); } }
            else if (SubString(command, 0, 3) == "-p " || SubString(command, 0, 3) == "-b ") {
                amount = S2I(SubString(command, 3, StringLength(command)));
                if (amount >= 1 && amount <= 10) {
                    if (SubString(command, 1, 2) == "p") { Show(0, amount); } else { Show(1, amount); }
                }
            }
        });
    }
}
//! endzinc
#endif

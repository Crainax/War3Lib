#ifndef KeyConstantsIncluded
#define KeyConstantsIncluded

// 按键ASCII码
#define KEY_CTRL    17
#define KEY_A       65
#define KEY_D       68
#define KEY_X       88
#define KEY_Z       90
#define KEY_C       67
#define KEY_ESC     27
#define KEY_F2      113
#define KEY_F3      114
#define KEY_F4      115
#define KEY_F5      116
#define KEY_CW      192
#define KEY_CONTROL 17
#define KEY_ALT     18
#define KEY_SHIFT   16
#define KEY_TAB     9
// 数字键1-6
#define KEY_1       49
#define KEY_2       50
#define KEY_3       51
#define KEY_4       52
#define KEY_5       53
#define KEY_6       54

// 按键事件
#define KEYBORAD_PRESSED 1
#define KEYBORAD_UP      0

#endif
